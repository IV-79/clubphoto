rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isLoggedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isRedacteur() {
      return isLoggedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'contributeur'
      );
    }

    // Profils membres (lecture publique pour les galeries)
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth.uid == uid || isAdmin();
    }

    // Articles (lecture publique pour statut=publie+portee=public, membres pour portee=membre)
    match /articles/{articleId} {
      allow read: if resource.data.statut == 'publie' && resource.data.portee == 'public';
      allow read: if isLoggedIn() && resource.data.statut == 'publie';
      allow read: if isRedacteur();
      allow create: if isRedacteur();
      allow update: if isRedacteur();
      allow delete: if isRedacteur();
    }

    // Photos du portfolio
    match /photos/{photoId} {
      allow read: if resource.data.visibilite == 'public'
                  || (isLoggedIn() && resource.data.visibilite == 'membre')
                  || (isLoggedIn() && resource.data.uid == request.auth.uid)
                  || isAdmin();
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isLoggedIn() && resource.data.uid == request.auth.uid;
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /photos/{photoId}/commentaires/{commentaireId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.auteurUid == request.auth.uid;
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        resource.data.auteurUid == request.auth.uid ||
        get(/databases/$(database)/documents/photos/$(photoId)).data.uid == request.auth.uid ||
        isAdmin()
      );
    }

    // Thèmes mensuels (lecture publique pour les galeries)
    match /themes/{themeId} {
      allow read: if true;
      allow write: if isAdmin();
      // Tout membre connecté peut incrémenter nbSoumissions / nbParticipants (soumission photo)
      allow update: if isLoggedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nbSoumissions', 'nbParticipants']);
    }

    match /themes/{themeId}/soumissions/{soumId} {
      allow read: if true;
      allow create: if isLoggedIn() && request.resource.data.membreUid == request.auth.uid;
      allow update: if isLoggedIn() && resource.data.membreUid == request.auth.uid;
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() && (resource.data.membreUid == request.auth.uid || isAdmin());
    }

    match /themes/{themeId}/soumissions/{soumId}/commentaires/{commentaireId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.auteurUid == request.auth.uid;
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        resource.data.auteurUid == request.auth.uid || isAdmin()
      );
    }

    match /themes/{themeId}/votes/{voteId} {
      allow read: if true;
      allow create, update: if isLoggedIn() && request.resource.data.voterUid == request.auth.uid;
      allow delete: if isLoggedIn() && (resource.data.voterUid == request.auth.uid || isAdmin());
    }

    // Réunions (lecture membres, écriture admin)
    match /reunions/{reunionId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // OneShot events (lecture publique sauf statut preparation)
    match /oneshots/{oneShotId} {
      allow read: if resource.data.statut != 'preparation'
                  || (isLoggedIn() && resource.data.creatorUid == request.auth.uid)
                  || isAdmin();
      allow create: if isLoggedIn();
      // Créateur ou admin : mise à jour complète (statut, titre, lieu, date…)
      allow update: if isLoggedIn() && (
        resource.data.creatorUid == request.auth.uid || isAdmin()
      );
      // Tout membre connecté peut incrémenter/décrémenter nbInscrits ou nbThemes
      allow update: if isLoggedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nbInscrits', 'nbThemes']);
      allow delete: if isLoggedIn() && (
        resource.data.creatorUid == request.auth.uid || isAdmin()
      );
    }

    match /oneshots/{oneShotId}/themes/{themeId} {
      allow read: if true;
      allow write: if isLoggedIn() && (
        get(/databases/$(database)/documents/oneshots/$(oneShotId)).data.creatorUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /oneshots/{oneShotId}/inscriptions/{uid} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/oneshots/$(oneShotId)).data.creatorUid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isLoggedIn() && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/oneshots/$(oneShotId)).data.creatorUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /oneshots/{oneShotId}/photos/{photoId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        resource.data.membreUid == request.auth.uid ||
        get(/databases/$(database)/documents/oneshots/$(oneShotId)).data.creatorUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /oneshots/{oneShotId}/photos/{photoId}/commentaires/{commentaireId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.auteurUid == request.auth.uid;
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        resource.data.auteurUid == request.auth.uid ||
        get(/databases/$(database)/documents/oneshots/$(oneShotId)).data.creatorUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /oneshots/{oneShotId}/votes/{voteId} {
      allow read: if true;
      allow create, update: if isLoggedIn() && request.resource.data.voterUid == request.auth.uid;
      allow delete: if isLoggedIn() && (resource.data.voterUid == request.auth.uid || isAdmin());
    }

    // Événements (ex-Sorties Photo) – lecture publique, création membres connectés
    match /sorties/{sortieId} {
      allow read: if true;
      allow create: if isLoggedIn();
      // Organisateur ou admin : mise à jour complète
      allow update: if isLoggedIn() && (
        resource.data.organisateurUid == request.auth.uid || isAdmin()
      );
      // Tout membre connecté peut incrémenter/décrémenter nbInscrits (inscription/désinscription)
      allow update: if isLoggedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nbInscrits']);
      allow delete: if isLoggedIn() && (
        resource.data.organisateurUid == request.auth.uid || isAdmin()
      );
    }

    match /sorties/{sortieId}/inscriptions/{uid} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/sorties/$(sortieId)).data.organisateurUid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isLoggedIn() && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/sorties/$(sortieId)).data.organisateurUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /sorties/{sortieId}/photos/{photoId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        resource.data.uploaderUid == request.auth.uid ||
        isAdmin() ||
        get(/databases/$(database)/documents/sorties/$(sortieId)).data.organisateurUid == request.auth.uid
      );
    }

    match /sorties/{sortieId}/photos/{photoId}/commentaires/{commentaireId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.auteurUid == request.auth.uid;
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        resource.data.auteurUid == request.auth.uid ||
        isAdmin() ||
        get(/databases/$(database)/documents/sorties/$(sortieId)).data.organisateurUid == request.auth.uid
      );
    }

    // Lecture collectionGroup inscriptions — pour le filtre "Participe" dans sorties-liste
    match /{parentPath=**}/inscriptions/{inscriptionId} {
      allow read: if isLoggedIn() && resource.data.uid == request.auth.uid;
    }

    // Dossiers de documents (lecture membres, écriture admin)
    match /documentDossiers/{dossierId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // Documents partagés
    match /documents/{documentId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.uploadeurUid == request.auth.uid;
      allow update: if isLoggedIn() && (resource.data.uploadeurUid == request.auth.uid || isAdmin());
      allow delete: if isLoggedIn() && (resource.data.uploadeurUid == request.auth.uid || isAdmin());
    }

    // Notifications par membre
    match /notifications/{uid}/items/{notifId} {
      allow read, update, delete: if request.auth.uid == uid;
      allow create: if isLoggedIn(); // tout membre peut créer pour autrui (broadcast + perso)
    }

    // Config site (lecture publique, écriture admin)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pages du club — Histoire, Bureau, Adhésion (lecture publique, écriture admin)
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Expositions photo — membres, organisateur, admin
    match /expositions/{expoId} {
      allow read: if isLoggedIn()
                  || resource.data.visibilite == 'public';
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (
        resource.data.organisateurUid == request.auth.uid || isAdmin()
      );
      allow delete: if isLoggedIn() && (
        resource.data.organisateurUid == request.auth.uid || isAdmin()
      );
    }

    match /expositions/{expoId}/suggestions/{suggId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (
        get(/databases/$(database)/documents/expositions/$(expoId)).data.organisateurUid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isLoggedIn() && (
        get(/databases/$(database)/documents/expositions/$(expoId)).data.organisateurUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /expositions/{expoId}/votes/{uid} {
      allow read: if isLoggedIn();
      allow create, update: if isLoggedIn() && request.auth.uid == uid;
      allow delete: if isLoggedIn() && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/expositions/$(expoId)).data.organisateurUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /expositions/{expoId}/photos/{photoId} {
      allow read: if isLoggedIn()
                  || get(/databases/$(database)/documents/expositions/$(expoId)).data.photosPubliques == true;
      allow create: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/expositions/$(expoId)).data.organisateurUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /soumissions/{soumissionId} {
      allow read: if true;
      allow create, update: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isLoggedIn() && resource.data.uid == request.auth.uid;
    }

    // Défis photo — lecture selon visibilité, écriture membres
    match /defis/{defiId} {
      allow read: if resource.data.visibilite == 'public' || isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (
        resource.data.organisateurUid == request.auth.uid || isAdmin()
      );
      allow update: if isLoggedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nbInscrits', 'nbParticipants']);
      allow delete: if isLoggedIn() && (
        resource.data.organisateurUid == request.auth.uid || isAdmin()
      );
    }

    match /defis/{defiId}/inscriptions/{uid} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.auth.uid == uid;
      allow delete: if isLoggedIn() && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/defis/$(defiId)).data.organisateurUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /defis/{defiId}/photos/{photoId} {
      allow read: if isLoggedIn() || get(/databases/$(database)/documents/defis/$(defiId)).data.visibilite == 'public';
      allow create: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        resource.data.membreUid == request.auth.uid ||
        get(/databases/$(database)/documents/defis/$(defiId)).data.organisateurUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /defis/{defiId}/votes/{voteId} {
      allow read: if isLoggedIn()
                  || get(/databases/$(database)/documents/defis/$(defiId)).data.visibilite == 'public';
      allow create, update: if isLoggedIn() && request.resource.data.voterUid == request.auth.uid;
      allow delete: if isLoggedIn() && (resource.data.voterUid == request.auth.uid || isAdmin());
    }

    match /defis/{defiId}/commentaires/{commentaireId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && request.resource.data.auteurUid == request.auth.uid;
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        resource.data.auteurUid == request.auth.uid || isAdmin()
      );
    }

  }
}
