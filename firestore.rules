rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isLoggedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Profils membres (lecture publique pour les galeries)
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth.uid == uid || isAdmin();
    }

    // Photos du portfolio
    match /photos/{photoId} {
      // Le propriétaire peut toujours lire ses propres photos (getMyPhotos sans filtre de visibilité)
      allow read: if resource.data.visibilite == 'public'
                  || (isLoggedIn() && resource.data.visibilite == 'membre')
                  || (isLoggedIn() && resource.data.uid == request.auth.uid);
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      // Propriétaire : tous les champs — autres membres connectés : likes seulement (atomique)
      allow update: if isLoggedIn() && resource.data.uid == request.auth.uid;
      allow update: if isLoggedIn(); // likes via arrayUnion/arrayRemove par les autres membres
      allow delete: if isLoggedIn() && resource.data.uid == request.auth.uid;
    }

    match /photos/{photoId}/commentaires/{commentaireId} {
      allow read: if true;
      allow create: if isLoggedIn() && request.resource.data.auteurUid == request.auth.uid;
      allow update: if isLoggedIn(); // likes et replies via arrayUnion/arrayRemove
      allow delete: if isLoggedIn() && (
        resource.data.auteurUid == request.auth.uid ||
        get(/databases/$(database)/documents/photos/$(photoId)).data.uid == request.auth.uid
      );
    }

    // Thèmes mensuels (lecture publique pour les galeries)
    match /themes/{themeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /themes/{themeId}/soumissions/{soumId} {
      allow read: if true;
      allow create: if isLoggedIn() && request.resource.data.membreUid == request.auth.uid;
      allow update: if isLoggedIn() && resource.data.membreUid == request.auth.uid;
      allow update: if isLoggedIn(); // likes via arrayUnion/arrayRemove par les autres membres
      allow delete: if isLoggedIn() && (resource.data.membreUid == request.auth.uid || isAdmin());
    }

    match /themes/{themeId}/soumissions/{soumId}/commentaires/{commentaireId} {
      allow read: if true;
      allow create: if isLoggedIn() && request.resource.data.auteurUid == request.auth.uid;
      allow update: if isLoggedIn(); // likes et replies
      allow delete: if isLoggedIn() && (
        resource.data.auteurUid == request.auth.uid || isAdmin()
      );
    }

    match /themes/{themeId}/votes/{voteId} {
      allow read: if true;
      allow create, update: if isLoggedIn() && request.resource.data.voterUid == request.auth.uid;
      allow delete: if isLoggedIn() && resource.data.voterUid == request.auth.uid;
    }

    // Événements (lecture publique, écriture admin)
    match /evenements/{evenementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // OneShot events (lecture publique sauf statut preparation)
    match /oneshots/{oneShotId} {
      allow read: if resource.data.statut != 'preparation'
                  || (isLoggedIn() && resource.data.creatorUid == request.auth.uid);
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && resource.data.creatorUid == request.auth.uid;
    }

    match /oneshots/{oneShotId}/themes/{themeId} {
      allow read: if true;
      allow write: if isLoggedIn() &&
        get(/databases/$(database)/documents/oneshots/$(oneShotId)).data.creatorUid == request.auth.uid;
    }

    match /oneshots/{oneShotId}/inscriptions/{uid} {
      allow read: if true;
      allow create, delete: if isLoggedIn() && request.auth.uid == uid;
    }

    match /oneshots/{oneShotId}/photos/{photoId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update: if isLoggedIn(); // likes via arrayUnion/arrayRemove
      allow delete: if isLoggedIn() && (
        resource.data.membreUid == request.auth.uid ||
        get(/databases/$(database)/documents/oneshots/$(oneShotId)).data.creatorUid == request.auth.uid
      );
    }

    match /oneshots/{oneShotId}/photos/{photoId}/commentaires/{commentaireId} {
      allow read: if true;
      allow create: if isLoggedIn() && request.resource.data.auteurUid == request.auth.uid;
      allow update: if isLoggedIn(); // likes et replies
      allow delete: if isLoggedIn() && (
        resource.data.auteurUid == request.auth.uid ||
        get(/databases/$(database)/documents/oneshots/$(oneShotId)).data.creatorUid == request.auth.uid
      );
    }

    match /oneshots/{oneShotId}/votes/{voteId} {
      allow read: if true;
      allow create, update: if isLoggedIn() && request.resource.data.voterUid == request.auth.uid;
    }

    // Sorties Photo (lecture publique, création membres connectés)
    match /sorties/{sortieId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (
        resource.data.organisateurUid == request.auth.uid || isAdmin()
      );
      allow delete: if isLoggedIn() && (
        resource.data.organisateurUid == request.auth.uid || isAdmin()
      );
    }

    match /sorties/{sortieId}/inscriptions/{uid} {
      allow read: if true;
      allow create: if isLoggedIn() && request.auth.uid == uid;
      allow delete: if isLoggedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /sorties/{sortieId}/photos/{photoId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update: if isLoggedIn(); // likes via arrayUnion/arrayRemove
      allow delete: if isLoggedIn() && (
        resource.data.uploaderUid == request.auth.uid ||
        isAdmin() ||
        get(/databases/$(database)/documents/sorties/$(sortieId)).data.organisateurUid == request.auth.uid
      );
    }

    match /sorties/{sortieId}/photos/{photoId}/commentaires/{commentaireId} {
      allow read: if true;
      allow create: if isLoggedIn() && request.resource.data.auteurUid == request.auth.uid;
      allow update: if isLoggedIn(); // likes et replies via arrayUnion/arrayRemove
      allow delete: if isLoggedIn() && (
        resource.data.auteurUid == request.auth.uid ||
        isAdmin() ||
        get(/databases/$(database)/documents/sorties/$(sortieId)).data.organisateurUid == request.auth.uid
      );
    }

    // Config site (lecture publique pour le formulaire upload, écriture admin)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Soumissions (lecture publique pour les galeries de thèmes)
    match /soumissions/{soumissionId} {
      allow read: if true;
      allow create, update: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isLoggedIn() && resource.data.uid == request.auth.uid;
    }

  }
}
