rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Photos de profil et bandeau
    match /user-photos/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Photos OneShot
    match /oneshots/{oneShotId}/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Photos Sorties Photo
    match /sorties/{sortieId}/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Couvertures d'articles
    match /articles/{articleId}/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Photos Défis photo
    match /defis/{defiId}/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Photos portfolio membres
    match /photos/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Photos soumissions thèmes du mois
    match /themes/{themeId}/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Listing récursif pour la maintenance admin (détection orphelins)
    // allow list couvre listAll() à n'importe quel niveau sous ces préfixes
    match /themes/{allPaths=**}   { allow list: if request.auth != null; }
    match /oneshots/{allPaths=**} { allow list: if request.auth != null; }
    match /defis/{allPaths=**}    { allow list: if request.auth != null; }
    match /sorties/{allPaths=**}  { allow list: if request.auth != null; }

    // Image hero (admin uniquement en écriture)
    match /config/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Documents partagés membres
    match /documents/{docId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

  }
}
