rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Photos de profil et bandeau
    match /user-photos/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Photos OneShot
    match /oneshots/{oneShotId}/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Photos Sorties Photo
    match /sorties/{sortieId}/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Couvertures d'articles
    match /articles/{articleId}/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Documents partagés membres
    match /documents/{docId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

  }
}
